# ================================================================
# Chatbot de RH: configuração do deploy na empresa
# Copie para .env e preencha. Nunca versione o .env.
# Lista completa de opções do Chatwoot:
# https://github.com/chatwoot/chatwoot/blob/develop/.env.example
# ================================================================

# ---------- Chatwoot ----------
# Gerar com: openssl rand -hex 64
SECRET_KEY_BASE=
# Endereço público do atendimento (o mesmo configurado no proxy).
# O Chatwoot usa este endereço para registrar o webhook do WhatsApp na Meta.
FRONTEND_URL=https://atendimento.EMPRESA.com.br
# Mude para true depois de confirmar que o proxy envia "X-Forwarded-Proto: https".
FORCE_SSL=false
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false
# Desliga o envio de métricas de uso para a Chatwoot.
# Atenção: qualquer valor desliga (até "false"). Para manter o envio, apague a linha.
DISABLE_TELEMETRY=true
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ACTIVE_STORAGE_SERVICE=local

# ---------- PostgreSQL da empresa ----------
# Requisitos: extensões vector (pgvector), pg_trgm, pgcrypto e pg_stat_statements.
# O DBA pode preparar tudo com postgres/preparar-banco.sql.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=

# ---------- Redis (container do compose) ----------
# O Redis roda neste compose, na rede bot-rh-interna, sem porta publicada.
REDIS_URL=redis://redis:6379
# Gerar com: openssl rand -hex 24 (usado pelo Redis e pelo Chatwoot)
REDIS_PASSWORD=

# ---------- E-mail (convites e redefinição de senha do RH) ----------
MAILER_SENDER_EMAIL=Atendimento RH <atendimento@EMPRESA.com.br>
SMTP_DOMAIN=EMPRESA.com.br
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# ---------- Integração com o n8n da empresa ----------
# O Chatwoot bloqueia chamadas para endereços de rede interna. Se o webhook do
# n8n da empresa resolver para um IP interno, esta variável precisa ser true.
# Ela reduz a proteção contra chamadas indevidas à rede interna (ver README).
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true

# ---------- App de celular do RH ----------
# As notificações do app oficial passam pelo servidor de repasse da Chatwoot.
ENABLE_PUSH_RELAY_SERVER=true
